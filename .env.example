# Deepgram TTS Configuration
# Get your API key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_api_key_here

# Optional: TTS Settings
# Available models: aura-asteria-en, aura-luna-en, aura-stella-en, aura-athena-en, aura-hera-en, aura-orion-en, aura-arcas-en, aura-perseus-en, aura-angus-en, aura-orpheus-en, aura-helios-en, aura-zeus-en
DEEPGRAM_MODEL=aura-asteria-en

# Audio encoding format (mp3, linear16, flac, etc.)
DEEPGRAM_ENCODING=mp3

# Sample rate in Hz (8000, 16000, 24000, 48000)
DEEPGRAM_SAMPLE_RATE=24000

# LLM Configuration
# Provider: litellm (unified), openai, gemini
LLM_PROVIDER=litellm

# Model name (depends on provider)
# LiteLLM: gpt-3.5-turbo, gpt-4, claude-3-sonnet, gemini-pro, ollama/llama2, etc.
# OpenAI: gpt-3.5-turbo, gpt-4, gpt-4-turbo
# Gemini: gemini-pro, gemini-pro-vision
LLM_MODEL=gpt-3.5-turbo

# Generation temperature (0.0-1.0, higher = more creative)
LLM_TEMPERATURE=0.7

# Maximum tokens to generate
LLM_MAX_TOKENS=1000

# LLM API Keys (at least one required based on LLM_PROVIDER)
# Get OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Get Gemini key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Get Anthropic key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here
